# DeepSeek — leave empty to use the stub provider (app still runs)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Retrieval
RAG_TOP_K=4
ABSTAIN_SCORE_THRESHOLD=0.55
CORPUS_DIR=data/corpus

# Chroma Cloud — leave empty to use in-memory Chroma (app still runs)
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=craftify_assignment
CHROMA_COLLECTION_DOCS=craftify_docs
CHROMA_COLLECTION_TICKETS=craftify_tickets

# Logging (relative to backend/ unless absolute)
LOG_PATH=../logs/tool_calls.jsonl
